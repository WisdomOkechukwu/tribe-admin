# Copy to .env.local. All values below are dev defaults; set real ones in production.

# HMAC secret for the admin session cookie (32+ chars). REQUIRED in production.
ADMIN_SESSION_SECRET=

# Seeded admin passwords. Either one shared password…
ADMIN_SEED_PASSWORD=
# …or one per role (takes precedence):
# ADMIN_PASSWORD_SUPER_ADMIN=
# ADMIN_PASSWORD_OPS=
# ADMIN_PASSWORD_SUPPORT=

# Without the values above, dev uses password "Tribe@Admin2026" for
#   super@tribe.africa (super admin), ops@tribe.africa (ops), support@tribe.africa (support).
# Production refuses dev defaults unless you explicitly opt in for a demo:
# TRIBE_ADMIN_ALLOW_DEV_SECRET=1
