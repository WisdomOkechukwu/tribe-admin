# Copy to .env.local. Set real values in production.

# Go admin API (tribe-backend). Every read and write goes through it.
TRIBE_API_URL=http://localhost:8080

# Key for the encrypted admin session cookie (32+ chars). REQUIRED in production.
ADMIN_SESSION_SECRET=

# Sign-in is checked by the Go API (POST /admin-api/sessions); there are no
# local passwords. Production refuses the built-in dev session key unless you
# explicitly opt in for a demo:
# TRIBE_ADMIN_ALLOW_DEV_SECRET=1
